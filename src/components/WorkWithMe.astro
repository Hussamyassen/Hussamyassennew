---
import '../styles/work.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import MobileContactBar from './MobileContactBar.astro';
import { getWork } from '../content/work';
import { workWhatsApp, type InquiryType } from '../lib/work';
import { contactTrackingAttributes } from '../lib/tracking';
import { telHref } from '../config/site';
import type { Locale } from '../lib/i18n';
const {locale}=Astro.props as {locale:Locale};
const t=getWork(locale);
---
<Header locale={locale} page="work" />
<main id="main" class="wwm">
  <section class="wwm-hero shell" aria-labelledby="wwm-title"><p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span>{t.eyebrow}</p><h1 id="wwm-title">{t.hero}</h1><p class="wwm-lead">{t.lead}</p><div class="hero-actions"><a class="button button-lime" href={workWhatsApp(locale)} target="_blank" rel="noopener noreferrer" {...contactTrackingAttributes('whatsapp','hero')} data-inquiry-type="general">{t.primary} <span aria-hidden="true">↗</span></a><a class="text-link" href="#scope">{t.secondary} <span aria-hidden="true">↘</span></a></div><div class="wwm-hero-rule" aria-hidden="true"><span>Google Ads</span><span>Meta Ads</span><span>Strategy · Creative · Measurement</span></div></section>
  <section class="wwm-section shell" id="situations" aria-labelledby="situations-title"><div class="wwm-section-top"><span class="section-index">01</span><h2 id="situations-title">{t.situationsTitle}</h2></div><div class="wwm-situations">{t.situations.map(([name,body],i)=><article><span class="wwm-smallnum">0{i+1}</span><h3>{name}</h3><p>{body}</p></article>)}</div></section>
  <section class="wwm-section shell" id="scope" aria-labelledby="scope-title"><div class="wwm-section-top"><span class="section-index">02</span><div><h2 id="scope-title">{t.scopeTitle}</h2><p class="wwm-intro">{t.scopeIntro}</p></div></div><div class="wwm-scope">{t.scope.map(([name,body,note],i)=><article><span class="wwm-smallnum">0{i+1}</span><div><h3>{name}</h3><p>{body}</p>{note && <p class="wwm-note">{note}</p>}</div></article>)}</div></section>
  <section class="wwm-options" id="collaboration" aria-labelledby="options-title"><div class="shell"><div class="wwm-section-top"><span class="section-index">03</span><h2 id="options-title">{t.optionsTitle}</h2></div><div class="wwm-options-list">{t.options.map(([name,body,cta,type],i)=><article><div class="wwm-option-heading"><span>0{i+1}</span><h3>{name}</h3></div><p>{body}</p><a href={workWhatsApp(locale,type as InquiryType)} target="_blank" rel="noopener noreferrer" {...contactTrackingAttributes('whatsapp','section')} data-inquiry-type={type}>{cta} <span aria-hidden="true">↗</span></a></article>)}</div></div></section>
  <section class="wwm-section shell" id="process" aria-labelledby="process-title"><div class="wwm-section-top"><span class="section-index">04</span><h2 id="process-title">{t.processTitle}</h2></div><ol class="wwm-steps">{t.steps.map(([name,body],i)=><li><span class="wwm-smallnum">0{i+1}</span><div><h3>{name}</h3><p>{body}</p></div></li>)}</ol></section>
  <section class="wwm-support" id="expertise" aria-labelledby="supporting-title"><div class="shell wwm-support-inner"><div><span class="section-index">05</span><h2 id="supporting-title">{t.supportingTitle}</h2></div><div><p>{t.supporting}</p><a class="text-link" href={`/${locale}/#work`}>{t.workLink} <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="wwm-section shell wwm-faq" id="faq" aria-labelledby="faq-title"><div class="wwm-section-top"><span class="section-index">06</span><h2 id="faq-title">{t.faqTitle}</h2></div><div class="wwm-faq-items">{t.faq.map(([q,a])=><details><summary>{q}<span class="wwm-plus" aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
  <section class="section contact-section" id="contact" aria-labelledby="work-contact-title"><div class="shell contact-layout"><div><span class="section-index">07</span><h2 id="work-contact-title">{t.contactTitle}</h2><p>{t.contactBody}</p></div><div class="contact-actions"><a class="button button-lime" href={workWhatsApp(locale)} target="_blank" rel="noopener noreferrer" {...contactTrackingAttributes('whatsapp','section')} data-inquiry-type="general">{t.contactWhats} <span aria-hidden="true">↗</span></a><a class="button button-outline" href={telHref} {...contactTrackingAttributes('phone','section')}>{t.contactCall} <span aria-hidden="true">↗</span></a></div></div></section>
</main>
<Footer locale={locale} page="work" />
<MobileContactBar locale={locale} page="work" />
