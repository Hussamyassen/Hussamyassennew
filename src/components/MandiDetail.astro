---
import Header from './Header.astro';
import Footer from './Footer.astro';
import MobileContactBar from './MobileContactBar.astro';
import {mandiDetail,mandiWhatsApp} from '../content/mandiDetail';
import {getProjects} from '../content/projects';
import {contactTrackingAttributes} from '../lib/tracking';
import type {Locale} from '../lib/i18n';
const {locale}=Astro.props as {locale:Locale};
const t=mandiDetail[locale];
const project=getProjects(locale).find(p=>p.id==='mandi')!;
const asset=project.authenticAsset;
---
<Header locale={locale} page="mandi-detail" />
<main id="main" class="mandi-detail">
  <section class="mandi-hero shell" aria-labelledby="mandi-heading">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1 id="mandi-heading">{t.title}</h1>
    <p class="mandi-lede">{t.intro}</p>
    <div class="mandi-actions"><a class="button button-lime" href={mandiWhatsApp(locale)} target="_blank" rel="noopener noreferrer" data-inquiry-type="mandi-project" {...contactTrackingAttributes('whatsapp','hero')}>{t.cta} ↗</a><a class="text-link" href={`/${locale}/work/`}>{t.back} ↗</a></div>
  </section>
  <section class="mandi-facts shell" aria-label={locale==='ar'?'ملخص المشروع':locale==='pt'?'Resumo do projeto':'Project overview'}>
    {t.summaryLabels.map((label,i)=><div class="mandi-fact"><h2>{label}</h2><p>{t.summaryValues[i]}</p></div>)}
  </section>
  <section class="mandi-context shell" aria-labelledby="mandi-context-title"><p class="mandi-kicker">01 / 04</p><div><h2 id="mandi-context-title">{t.contextTitle}</h2><p>{t.context}</p></div></section>
  <section class="mandi-ad-block" aria-labelledby="mandi-ads-title"><div class="shell mandi-ad-grid"><div><p class="mandi-kicker">02 / 04 · Google Ads</p><h2 id="mandi-ads-title">{t.adsTitle}</h2><p>{t.adsBody}</p><p>{t.adsExplanation}</p></div><div class="mandi-metric"><span class="mandi-metric-overline">Google Ads / CTR</span><strong dir="ltr">{project.metric.value}</strong><p>{locale==='ar'?'CTR في بعض الفترات':project.metric.label}</p><small>{project.metric.note}</small></div></div></section>
  <section class="mandi-local shell" aria-labelledby="mandi-maps-title"><p class="mandi-kicker">03 / 04 · Google Maps</p><div class="mandi-local-grid"><div><h2 id="mandi-maps-title">{t.mapsTitle}</h2><p>{asset?t.mapsBody:(locale==='ar'?'شمل عملي الحضور الرقمي المحلي للمطعم.':locale==='pt'?'O meu trabalho incluiu a presença digital local do restaurante.':'My work included the restaurant’s local digital presence.')}</p></div>{asset && <figure class="mandi-screenshot"><div class="mandi-maps-figures"><span><strong dir="ltr">4.7/5</strong><span>{t.mapsRating}</span></span><span><strong dir="ltr">1,865</strong><span>{t.mapsReviews}</span></span></div><a href={asset.original} target="_blank" rel="noopener noreferrer"><img src={asset.src} alt={asset.alt} width="900" height="650" loading="lazy" decoding="async" /><span>{t.mapsOriginal} ↗</span></a><figcaption>{t.mapsCaption}</figcaption></figure>}</div></section>
  <section class="mandi-ai shell" aria-labelledby="mandi-ai-title"><p class="mandi-kicker">04 / 04 · GEO</p><div><h2 id="mandi-ai-title">{t.aiTitle}</h2><p>{t.aiBody}</p><small>{t.aiNote}</small></div></section>
  <section class="mandi-reading shell" aria-labelledby="mandi-reading-title"><h2 id="mandi-reading-title">{t.readingTitle}</h2><p>{t.reading}</p></section>
  <section class="mandi-contact" aria-labelledby="mandi-contact-title"><div class="shell mandi-contact-inner"><div><h2 id="mandi-contact-title">{t.contactTitle}</h2><p>{t.contactBody}</p></div><div class="mandi-contact-actions"><a class="button button-lime" href={mandiWhatsApp(locale)} target="_blank" rel="noopener noreferrer" data-inquiry-type="mandi-project" {...contactTrackingAttributes('whatsapp','section')}>{t.contactCta} ↗</a><a class="text-link" href={`/${locale}/work-with-me/`}>{t.servicesLink} ↗</a></div></div></section>
</main>
<Footer locale={locale} page="mandi-detail" />
<MobileContactBar locale={locale} page="mandi-detail" />
