---
import type {Locale} from '../lib/i18n';
import Header from './Header.astro';import Footer from './Footer.astro';import MobileContactBar from './MobileContactBar.astro';
import {insightsCopy,insightsWhatsApp} from '../content/insights';
import {publishedArticles,readingMinutes} from '../content/insights/types';
import {contactTrackingAttributes} from '../lib/tracking';
const {locale}=Astro.props as {locale:Locale}; const t=insightsCopy[locale];const articles=publishedArticles(locale);
---
<Header locale={locale} page="insights" />
<main id="main" class="insights-page">
 <section class="shell insights-hero" aria-labelledby="insights-heading"><p class="eyebrow">{t.eyebrow}</p><h1 id="insights-heading">{t.hero}</h1><p class="insights-lead">{t.intro}</p><a class="text-link" href="#editorial">{t.seriesTitle} ↓</a></section>
 <section class="shell insights-published" aria-labelledby="published-heading"><div class="insights-row-heading"><h2 id="published-heading">{t.published}</h2><span aria-hidden="true">01 / 03</span></div>
 {articles.length===0?<div class="insights-empty"><h3>{t.emptyTitle}</h3><p>{t.emptyBody}</p><a href={`/${locale}/work/`}>{t.viewWork} ↗</a></div>:<div class="insights-articles">{articles.map(a=><article><p>{t.series[a.series==='decision-notebook'?0:a.series==='after-the-click'?1:2].title}</p><h3><a href={`/${locale}/insights/${a.slug}/`}>{a.title}</a></h3><p>{a.description}</p><small>{readingMinutes(a.body)} {locale==='ar'?'دقائق قراءة':locale==='pt'?'min de leitura':'min read'}</small></article>)}</div>}
 </section>
 <section class="insights-editorial" id="editorial" aria-labelledby="editorial-heading"><div class="shell"><div class="insights-row-heading"><h2 id="editorial-heading">{t.seriesTitle}</h2><span aria-hidden="true">02 / 03</span></div><div class="insights-series">{t.series.map((entry,i)=><article class="insights-series-entry"><span class="insights-number">0{i+1}</span><div><h3>{entry.title}</h3><p>{entry.body}</p></div></article>)}</div></div></section>
 <section class="shell insights-examples" aria-labelledby="examples-heading"><div class="insights-row-heading"><h2 id="examples-heading">{t.examplesTitle}</h2><span aria-hidden="true">03 / 03</span></div><p>{t.examplesIntro}</p><div class="insights-project-links"><a href={`/${locale}/work/mandi-al-deera/`}>{t.mandi} <span aria-hidden="true">↗</span></a><a href={`/${locale}/work/geberit-campaign/`}>{t.geberit} <span aria-hidden="true">↗</span></a><a href={`/${locale}/work/`}>{t.allWork} <span aria-hidden="true">↗</span></a></div></section>
 <section class="contact-section insights-contact" aria-labelledby="insights-contact-heading"><div class="shell contact-layout"><div><h2 id="insights-contact-heading">{t.contactTitle}</h2><p>{t.contactBody}</p></div><div class="contact-actions"><a class="button button-lime" href={insightsWhatsApp(locale)} target="_blank" rel="noopener noreferrer" data-inquiry-type="campaign-question" {...contactTrackingAttributes('whatsapp','section')}>{t.contactCta} ↗</a></div></div></section>
</main>
<Footer locale={locale} page="insights" /><MobileContactBar locale={locale} page="insights" />
