---
import { telHref } from '../config/site';
import { messages, whatsappHref, type Locale } from '../lib/i18n';
import { contactTrackingAttributes } from '../lib/tracking';
import type { ContactPlacement } from '../config/site';
interface Props { locale: Locale; placement?: ContactPlacement; }
const { locale, placement = 'other' } = Astro.props;
---
<div class="contact-links">
  <a class="primary" href={whatsappHref(locale)} target="_blank" rel="noopener noreferrer" {...contactTrackingAttributes('whatsapp', placement)}>{messages[locale].whatsappLabel}</a>
  <a href={telHref} {...contactTrackingAttributes('phone', placement)}>{messages[locale].callLabel}</a>
</div>
<style>
.contact-links { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
.contact-links a { min-height: 44px; padding: .75rem 1.25rem; border: 1px solid var(--color-ink); text-decoration: none; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); }
.contact-links .primary { background: var(--color-lime); color: var(--color-ink); font-weight: 600; }
</style>
