---
import Header from './Header.astro';
import Footer from './Footer.astro';
import MobileContactBar from './MobileContactBar.astro';
import {geberitDetail,geberitWhatsApp} from '../content/geberitDetail';
import {getProjects} from '../content/projects';
import {contactTrackingAttributes} from '../lib/tracking';
import type {Locale} from '../lib/i18n';
const {locale}=Astro.props as {locale:Locale};
const t=geberitDetail[locale];
const project=getProjects(locale).find(p=>p.id==='geberit')!;
---
<Header locale={locale} page="geberit-detail" />
<main id="main" class="geberit-detail">
  <nav class="geberit-breadcrumb shell" aria-label="Breadcrumb"><a href={`/${locale}/`}>{t.crumbHome}</a><span aria-hidden="true">/</span><a href={`/${locale}/work/`}>{t.crumbWork}</a><span aria-hidden="true">/</span><span aria-current="page">{t.crumbCurrent}</span></nav>
  <section class="geberit-hero shell" aria-labelledby="geberit-title"><p class="eyebrow">{t.eyebrow}</p><h1 id="geberit-title">{t.title}</h1><p class="geberit-intro">{t.intro}</p><div class="geberit-actions"><a class="button button-lime" href={geberitWhatsApp(locale)} target="_blank" rel="noopener noreferrer" data-inquiry-type="geberit-project" {...contactTrackingAttributes('whatsapp','hero')}>{t.cta} <span aria-hidden="true">↗</span></a><a class="text-link" href={`/${locale}/work/`}>{t.back} ↗</a></div></section>
  <section class="geberit-facts shell" aria-label={locale==='ar'?'ملخص المشروع':locale==='pt'?'Resumo do projeto':'Project summary'}>{t.facts.map((label,i)=><div class="geberit-fact"><h2>{label}</h2><p>{t.values[i]}</p></div>)}</section>
  <section class="geberit-sales"><div class="shell geberit-sales-layout"><div><p class="geberit-kicker">Instagram · Video Campaign</p><h2>{t.result}</h2><p>{t.resultBody}</p></div><div class="geberit-sales-figure"><strong dir="ltr">{project.metric.value}</strong><p>{project.metric.label}</p><small>{t.note}</small></div></div></section>
  <section class="geberit-story shell"><span aria-hidden="true" class="geberit-story-index">01 / 01</span><div><h2>{t.narrative}</h2><p>{t.narrativeBody}</p><p><a class="text-link" href={`/${locale}/work/mandi-al-deera/`}>{t.related} ↗</a></p></div></section>
  <section class="geberit-contact"><div class="shell geberit-contact-layout"><div><h2>{t.contactTitle}</h2><p>{t.contactBody}</p></div><div class="geberit-contact-actions"><a class="button button-lime" href={geberitWhatsApp(locale)} target="_blank" rel="noopener noreferrer" data-inquiry-type="geberit-project" {...contactTrackingAttributes('whatsapp','section')}>{t.contactCta} ↗</a><a class="text-link" href={`/${locale}/work-with-me/`}>{t.services} ↗</a></div></div></section>
</main>
<Footer locale={locale} page="geberit-detail" />
<MobileContactBar locale={locale} page="geberit-detail" />
