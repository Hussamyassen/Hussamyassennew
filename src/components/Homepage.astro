---
import type {Locale} from '../lib/i18n';import {whatsappHref} from '../lib/i18n';import {contactTrackingAttributes} from '../lib/tracking';import {telHref} from '../config/site';import {getHome} from '../content/home';
import {getProjects} from '../content/projects';import {mandiDetail} from '../content/mandiDetail';
import Header from './Header.astro';import Footer from './Footer.astro';import MobileContactBar from './MobileContactBar.astro';
const {locale}=Astro.props as {locale:Locale};const t=getHome(locale);const geberitMetric=getProjects(locale)[1].metric;
// Asset presence is explicit: no unapproved or placeholder people/images.
// Stage 11: approved photographs supplied by owner and retained as original assets.
---
<Header locale={locale}/>
<main id="main">
<section class="hero shell" aria-labelledby="hero-heading"><div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line"></span>{t.eyebrow}</p><h1 id="hero-heading">{t.hero}</h1><p class="hero-lead">{t.introduction}</p><div class="hero-actions"><a class="button button-lime" href={whatsappHref(locale)} target="_blank" rel="noopener noreferrer" {...contactTrackingAttributes('whatsapp','hero')}>{t.primary}<span aria-hidden="true">↗</span></a><a class="text-link" href="#work">{t.workAction}<span aria-hidden="true">↘</span></a></div></div><div class="hero-art"><div class="hero-art-top"><span class="art-cross" aria-hidden="true">✳</span><span>01 / 02</span></div><img class="homepage-portrait" src="/images/hussam-office-doorway.webp" width="900" height="1350" fetchpriority="high" loading="eager" decoding="async" alt={locale==='ar'?'حسام ياسين واقف في مدخل مكتب':locale==='pt'?'Hussam Yassen em pé à entrada de um escritório':'Hussam Yassen standing in an office doorway'}/><p class="hero-aside">{t.heroAside}</p></div></section>
<section id="services" class="section services shell" aria-labelledby="services-title"><div class="section-intro"><span class="section-index">01 / {t.nav[0]}</span><h2 id="services-title">{t.servicesTitle}</h2><p>{t.serviceIntro}</p></div><div class="service-list">{t.serviceTitles.map((heading,i)=><article class="service-item"><span class="number">0{i+1}</span><div><h3>{heading}</h3><p>{t.serviceBodies[i]}</p></div><span class="service-arrow" aria-hidden="true">↗</span></article>)}</div></section>
<section id="work" class="section work-section" aria-labelledby="work-title"><div class="shell"><div class="section-intro work-intro"><span class="section-index">02 / {t.nav[1]}</span><h2 id="work-title">{t.workTitle}</h2><p>{t.workIntro}</p></div><div class="work-project project-mandi"><div class="project-identifier"><span class="project-n">01 / 02</span><div class="project-emblem" aria-hidden="true">M<span>.</span></div></div><div class="project-copy"><p class="project-scope">{t.mandiScope}</p><h3>{t.mandi}</h3><p>{t.mandiBody}</p><a class="project-link" href={whatsappHref(locale)} target="_blank" rel="noopener noreferrer" {...contactTrackingAttributes('whatsapp','section')}>{t.projectCta} ↗</a><a class="project-link" href={`/${locale}/work/mandi-al-deera/`}>{mandiDetail[locale].detailsLink} ↗</a></div></div><div class="project-divider"></div><div class="work-project project-geberit"><div class="project-identifier"><span class="project-n">02 / 02</span><div class="project-emblem project-g" aria-hidden="true">G<span>.</span></div></div><div class="project-copy"><p class="project-scope">{t.geberitScope}</p><h3>{t.geberit}</h3><p>{t.geberitBody}</p><div class="sales-figure"><strong dir="auto">{geberitMetric.value}</strong><span>{geberitMetric.label}</span><small>{geberitMetric.note}</small></div><a class="project-link" href={whatsappHref(locale)} target="_blank" rel="noopener noreferrer" {...contactTrackingAttributes('whatsapp','section')}>{t.projectCta} ↗</a><a class="project-link" href={`/${locale}/work/geberit-campaign/`}>{mandiDetail[locale].detailsLink} ↗</a></div></div><div class="homepage-all-work"><a class="project-link" href={`/${locale}/work/`}>{locale==='ar'?'عرض الأعمال':locale==='pt'?'Ver todos os projetos':'View all work'} ↗</a></div></div></section>
<section id="process" class="section process shell" aria-labelledby="process-title"><div class="process-visual"><img class="homepage-whiteboard" src="/images/hussam-whiteboard.webp" width="1400" height="933" loading="lazy" decoding="async" alt={locale==='ar'?'حسام ياسين يشرح خطة حملة إعلانية على السبورة':locale==='pt'?'Hussam Yassen a explicar um plano de campanha num quadro branco':'Hussam Yassen reviewing a campaign plan at a whiteboard'}/></div><div class="process-content"><span class="section-index">03 / {t.nav[2]}</span><h2 id="process-title">{t.processTitle}</h2><p class="process-lead">{t.processIntro}</p><ol class="steps">{t.stepTitles.map((heading,i)=><li><span class="number">0{i+1}</span><div><h3>{heading}</h3><p>{t.stepBodies[i]}</p></div></li>)}</ol></div></section>
<section id="about" class="section about-section" aria-labelledby="about-title"><div class="shell about-layout"><div><span class="section-index">04 / {t.nav[3]}</span><h2 id="about-title">{t.aboutTitle}<span class="lime-period">.</span></h2></div><div class="about-copy"><p class="about-main">{t.aboutBody}</p><p>{t.aboutSupport}</p></div></div></section>
<section class="section knowledge shell" aria-labelledby="knowledge-title"><div class="section-intro"><span class="section-index">05 / {locale==='ar'?'المعرفة':locale==='pt'?'Artigos':'Insights'}</span><h2 id="knowledge-title">{t.knowledgeTitle}</h2><p>{t.knowledgeIntro}</p></div><div class="knowledge-items">{t.knowledgeTitles.map((heading,i)=><div class="knowledge-item"><span class="number">0{i+1}</span><h3>{heading}</h3><p>{t.knowledgeBodies[i]}</p><small>{t.knowledgeFuture}</small></div>)}</div><a class="text-link" href={`/${locale}/insights/`}>{locale==='ar'?'استكشف المقالات والمعرفة':locale==='pt'?'Explorar artigos e insights':'Explore insights'} ↗</a></section>
<section id="contact" class="section contact-section" aria-labelledby="contact-title"><div class="shell contact-layout"><div><span class="section-index">06 / {t.nav[4]}</span><h2 id="contact-title">{t.contactTitle}</h2><p>{t.contactBody}</p></div><div class="contact-actions"><a class="button button-lime" href={whatsappHref(locale)} target="_blank" rel="noopener noreferrer" {...contactTrackingAttributes('whatsapp','section')}>{t.contactWhats}<span aria-hidden="true">↗</span></a><a class="button button-outline" href={telHref} {...contactTrackingAttributes('phone','section')}>{t.contactCall}<span aria-hidden="true">↗</span></a></div></div></section>
</main><Footer locale={locale}/><MobileContactBar locale={locale}/>
