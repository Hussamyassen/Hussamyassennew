---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InsightArticle from '../../../components/InsightArticle.astro';
import {articles,translatedArticle,type InsightArticle} from '../../../content/insights/types';
import type {Locale} from '../../../lib/i18n';
export function getStaticPaths(){return articles.filter(a=>a.status==='published'&&a.body.trim()).map(a=>({params:{locale:a.locale,slug:a.slug},props:{article:a}}));}
const {article}=Astro.props as {article:InsightArticle};const locale=article.locale as Locale;
const pathname=`/${locale}/insights/${article.slug}/`;
const origin='https://husamyasen.com';
const alternates=Object.fromEntries((['ar','en','pt'] as Locale[]).map(l=>[l,translatedArticle(article,l)]).filter(([,a])=>Boolean(a)).map(([l,a])=>[l,`/${l}/insights/${(a as InsightArticle).slug}/`]));
const graph={'@context':'https://schema.org','@graph':[
 {'@type':'BlogPosting','@id':`${origin}${pathname}#article`,headline:article.title,description:article.description,inLanguage:locale,mainEntityOfPage:{'@id':`${origin}${pathname}#webpage`},author:{'@id':`${origin}/#person`}},
 {'@type':'WebPage','@id':`${origin}${pathname}#webpage`,url:`${origin}${pathname}`,name:article.title,inLanguage:locale,breadcrumb:{'@id':`${origin}${pathname}#breadcrumb`}},
 {'@type':'BreadcrumbList','@id':`${origin}${pathname}#breadcrumb`,itemListElement:[{'@type':'ListItem',position:1,name:locale==='ar'?'الرئيسية':locale==='pt'?'Início':'Home',item:`${origin}/${locale}/`},{'@type':'ListItem',position:2,name:locale==='ar'?'المقالات والمعرفة':locale==='pt'?'Artigos e insights':'Insights',item:`${origin}/${locale}/insights/`},{'@type':'ListItem',position:3,name:article.title,item:`${origin}${pathname}`}]},
 {'@type':'Person','@id':`${origin}/#person`,name:'Hussam Yassen',alternateName:'حسام ياسين',url:`${origin}/`,sameAs:['https://www.linkedin.com/in/hussam-yassen','https://www.instagram.com/growthlab.ae/']}
]};
---
<BaseLayout locale={locale} pathname={pathname} title={`${article.title} | Hussam Yassen`} description={article.description} alternates={alternates} indexable={true}><Fragment slot="structured-data"><script type="application/ld+json" set:html={JSON.stringify(graph)}/></Fragment><InsightArticle locale={locale} article={article}/></BaseLayout>
