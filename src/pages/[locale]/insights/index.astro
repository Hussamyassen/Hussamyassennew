---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InsightsIndex from '../../../components/InsightsIndex.astro';
import {locales,type Locale} from '../../../lib/i18n';
import {insightsCopy} from '../../../content/insights';
export function getStaticPaths(){return locales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as Locale;
const t=insightsCopy[locale];const pathname=`/${locale}/insights/`;
const origin='https://husamyasen.com';
const alternates={ar:'/ar/insights/',en:'/en/insights/',pt:'/pt/insights/'};
const graph={'@context':'https://schema.org','@graph':[
 {'@type':'CollectionPage','@id':`${origin}${pathname}#webpage`,url:`${origin}${pathname}`,name:t.title,description:t.description,inLanguage:locale,about:{'@id':`${origin}/#person`},author:{'@id':`${origin}/#person`},breadcrumb:{'@id':`${origin}${pathname}#breadcrumb`}},
 {'@type':'BreadcrumbList','@id':`${origin}${pathname}#breadcrumb`,itemListElement:[{'@type':'ListItem',position:1,name:t.home,item:`${origin}/${locale}/`},{'@type':'ListItem',position:2,name:t.nav,item:`${origin}${pathname}`}]},
 {'@type':'Person','@id':`${origin}/#person`,name:'Hussam Yassen',alternateName:'حسام ياسين',url:`${origin}/`,sameAs:['https://www.linkedin.com/in/hussam-yassen','https://www.instagram.com/growthlab.ae/']}
]};
---
<BaseLayout locale={locale} pathname={pathname} title={t.title} description={t.description} alternates={alternates} indexable={true}><Fragment slot="structured-data"><script type="application/ld+json" set:html={JSON.stringify(graph)} /></Fragment><InsightsIndex locale={locale}/></BaseLayout>
